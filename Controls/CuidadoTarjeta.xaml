<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="IdermaClinica.Controls.CuidadoTarjeta"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Raiz">
    <Border
        Margin="0,0,0,12"
        Style="{StaticResource CardStyle}">
        <StackPanel Spacing="10">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Padding="8,4"
                    Background="{Binding Cuidado.TipoTexto, ElementName=Raiz, Converter={StaticResource TipoAFondo}}"
                    CornerRadius="8">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{Binding Cuidado.TipoTexto, ElementName=Raiz, Converter={StaticResource TipoATexto}}"
                        Text="{Binding Cuidado.TipoTexto, ElementName=Raiz}" />
                </Border>
                <Border
                    Grid.Column="1"
                    Padding="8,4"
                    Background="{Binding Cuidado.Estado, ElementName=Raiz, Converter={StaticResource EstadoAFondo}}"
                    CornerRadius="8">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{Binding Cuidado.Estado, ElementName=Raiz, Converter={StaticResource EstadoAColor}}"
                        Text="{Binding Cuidado.Estado, ElementName=Raiz}" />
                </Border>
                <TextBlock
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    FontSize="22"
                    FontWeight="SemiBold"
                    Foreground="{Binding Cuidado.Estado, ElementName=Raiz, Converter={StaticResource EstadoAColor}}"
                    Text="{Binding Cuidado.AdherenciaTexto, ElementName=Raiz}" />
            </Grid>

            <TextBlock
                FontSize="18"
                FontWeight="SemiBold"
                Text="{Binding Cuidado.Nombre, ElementName=Raiz}"
                TextWrapping="Wrap" />
            <TextBlock
                Foreground="{StaticResource MutedBrush}"
                Text="{Binding Cuidado.LineaConCliente, ElementName=Raiz}"
                TextWrapping="Wrap" />
            <TextBlock
                FontWeight="SemiBold"
                Text="{Binding Cuidado.FrecuenciaTexto, ElementName=Raiz}" />
            <TextBlock Text="{Binding Cuidado.Indicacion, ElementName=Raiz}" TextWrapping="Wrap" />
            <TextBlock
                FontSize="12"
                Foreground="{StaticResource MutedBrush}"
                Text="{Binding Cuidado.ResumenDias, ElementName=Raiz}" />
            <TextBlock
                FontSize="12"
                Foreground="{StaticResource MutedBrush}"
                Text="{Binding Cuidado.InicioTexto, ElementName=Raiz}" />

            <ProgressBar
                Height="8"
                Maximum="100"
                Background="{StaticResource TrackBrush}"
                Foreground="{Binding Cuidado.Estado, ElementName=Raiz, Converter={StaticResource EstadoAColor}}"
                Value="{Binding Cuidado.PorcentajeAdherencia, ElementName=Raiz}" />

            <Border
                Padding="12,8"
                Background="{StaticResource EstadoRiesgoFondoBrush}"
                CornerRadius="8"
                Visibility="{Binding Cuidado.TieneAviso, ElementName=Raiz, Converter={StaticResource BoolAVisibilidad}}">
                <TextBlock
                    Foreground="{StaticResource EstadoRiesgoBrush}"
                    Text="{Binding Cuidado.AvisoVenta, ElementName=Raiz}"
                    TextWrapping="Wrap" />
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Click="Frecuencia_Click"
                    Content="Editar frecuencia"
                    Style="{StaticResource BotonSecundario}" />
                <Button
                    Click="Registrar_Click"
                    Content="{Binding Cuidado.TextoBotonHoy, ElementName=Raiz}"
                    IsEnabled="{Binding Cuidado.PuedeRegistrarHoy, ElementName=Raiz}"
                    Style="{StaticResource BotonPrimario}" />
                <Button
                    Click="Negativa_Click"
                    Content="{Binding Cuidado.TextoBotonNegativa, ElementName=Raiz}"
                    IsEnabled="{Binding Cuidado.PuedeRegistrarNegativa, ElementName=Raiz}"
                    Style="{StaticResource BotonSecundario}"
                    ToolTipService.ToolTip="Quita un día cumplido y devuelve el porcentaje anterior." />
                <Button
                    Click="PonerAlDia_Click"
                    Content="{Binding Cuidado.TextoBotonAlDia, ElementName=Raiz}"
                    IsEnabled="{Binding Cuidado.PuedePonerAlDia, ElementName=Raiz}"
                    Style="{StaticResource BotonSecundario}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
