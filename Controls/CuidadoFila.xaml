<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="IdermaClinica.Controls.CuidadoFila"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Name="Raiz">
    <Grid ColumnSpacing="12" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="108" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="168" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border
            Padding="8,4"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="{Binding Cuidado.TipoTexto, ElementName=Raiz, Converter={StaticResource TipoAFondo}}"
            CornerRadius="8">
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Foreground="{Binding Cuidado.TipoTexto, ElementName=Raiz, Converter={StaticResource TipoATexto}}"
                Text="{Binding Cuidado.TipoTexto, ElementName=Raiz}" />
        </Border>

        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock
                FontWeight="SemiBold"
                Text="{Binding Cuidado.Nombre, ElementName=Raiz}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Text="{Binding Cuidado.FrecuenciaTexto, ElementName=Raiz}"
                TextTrimming="CharacterEllipsis" />
            <TextBlock
                FontSize="12"
                Foreground="{StaticResource MutedBrush}"
                Text="{Binding Cuidado.LineaConCliente, ElementName=Raiz}"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding MostrarCliente, ElementName=Raiz, Converter={StaticResource BoolAVisibilidad}}" />
            <TextBlock
                FontSize="12"
                Foreground="{StaticResource MutedBrush}"
                Text="{Binding Cuidado.ResumenDias, ElementName=Raiz}"
                TextTrimming="CharacterEllipsis"
                Visibility="{Binding MostrarCliente, ElementName=Raiz, Converter={StaticResource BoolAVisibilidad}, ConverterParameter=invertir}" />
        </StackPanel>

        <TextBlock
            Grid.Column="2"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FontSize="12"
            FontWeight="SemiBold"
            Foreground="{Binding Cuidado.Estado, ElementName=Raiz, Converter={StaticResource EstadoAColor}}"
            Text="{Binding Cuidado.Estado, ElementName=Raiz}" />

        <Grid Grid.Column="3" VerticalAlignment="Center" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <ProgressBar
                Height="6"
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Maximum="100"
                Background="{StaticResource TrackBrush}"
                Foreground="{Binding Cuidado.Estado, ElementName=Raiz, Converter={StaticResource EstadoAColor}}"
                Value="{Binding Cuidado.PorcentajeAdherencia, ElementName=Raiz}" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                FontSize="12"
                Text="{Binding Cuidado.AdherenciaTexto, ElementName=Raiz}" />
        </Grid>

        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button
                Click="Frecuencia_Click"
                Content="Frecuencia"
                Style="{StaticResource BotonSecundario}" />
            <Button
                x:Name="BotonHoy"
                Width="156"
                Padding="14,6"
                Click="Registrar_Click"
                Content="Registrar hoy"
                Style="{StaticResource BotonPrimario}"
                Visibility="Collapsed" />
            <Button
                x:Name="BotonNegativa"
                Width="108"
                Padding="14,6"
                Click="Negativa_Click"
                Content="Negativa"
                Style="{StaticResource BotonSecundario}"
                ToolTipService.ToolTip="Quita un día cumplido y devuelve el porcentaje anterior."
                Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</UserControl>
