<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaClinica.Pages.OperacionesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IdermaClinica.Controls">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,32" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource KickerStyle}" Text="INTERVENCIONES" />
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Operaciones" />
                <TextBlock Style="{StaticResource SubtitleStyle}" Text="Cada intervención deja una pauta. Abajo está la medicación o la crema que el paciente tiene que cumplir." />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource KickerStyle}" Text="FACTURADO EN TOTAL" />
                        <TextBlock Style="{StaticResource CifraStyle}" Text="{Binding Store.ImporteOperacionesTexto}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource KickerStyle}" Text="ESTE MES" />
                        <TextBlock Style="{StaticResource CifraStyle}" Text="{Binding Store.ImporteMesTexto}" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    x:Name="FiltroCategoria"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="Filtro_SelectionChanged"
                    SelectedIndex="0">
                    <ComboBoxItem Content="Todas" />
                    <ComboBoxItem Content="Trasplante" />
                    <ComboBoxItem Content="Mesoterapia" />
                    <ComboBoxItem Content="PRP" />
                    <ComboBoxItem Content="Micropigmentación" />
                    <ComboBoxItem Content="Consulta" />
                </ComboBox>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource MutedBrush}"
                    Text="{Binding Conteo}" />
            </Grid>

            <TextBlock
                Style="{StaticResource SubtitleStyle}"
                Text="Ninguna operación coincide con el filtro."
                Visibility="{Binding NoHayResultados, Converter={StaticResource BoolAVisibilidad}}" />

            <ItemsControl ItemsSource="{Binding Visibles}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock FontSize="12" Foreground="{StaticResource GoldBrush}" Text="{Binding Categoria}" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding FechaTexto}" />
                                        </StackPanel>
                                        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Tipo}" TextWrapping="Wrap" />
                                        <TextBlock FontSize="16" Text="{Binding ClienteNombre}" />
                                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding MedicoZona}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detalle}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="6">
                                        <Button
                                            HorizontalAlignment="Right"
                                            Click="Abrir_Click"
                                            Content="Abrir"
                                            Style="{StaticResource BotonSecundario}" />
                                        <TextBlock
                                            HorizontalAlignment="Right"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="{Binding ImporteTexto}" />
                                        <Border
                                            Padding="8,4"
                                            HorizontalAlignment="Right"
                                            Background="{Binding EstadoOperacion, Converter={StaticResource EstadoAFondo}}"
                                            CornerRadius="8">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding EstadoOperacion, Converter={StaticResource EstadoAColor}}"
                                                Text="{Binding EstadoOperacion}" />
                                        </Border>
                                        <Border
                                            Padding="8,4"
                                            HorizontalAlignment="Right"
                                            Background="{Binding EstadoPauta, Converter={StaticResource EstadoAFondo}}"
                                            CornerRadius="8">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding EstadoPauta, Converter={StaticResource EstadoAColor}}"
                                                Text="{Binding EstadoPauta}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1" Background="{StaticResource LineBrush}" />
                                <TextBlock FontWeight="SemiBold" Text="Lo que esta operación obliga a cumplir" />
                                <ItemsControl ItemsSource="{Binding Cuidados}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,0,8"
                                                Padding="0,8,0,0"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="0,1,0,0">
                                                <controls:CuidadoFila Cuidado="{Binding}" MostrarCliente="False" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
