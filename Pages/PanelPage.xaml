<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaClinica.Pages.PanelPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IdermaClinica.Controls">
    <ScrollViewer>
        <StackPanel Padding="28,20,28,32" Spacing="18">
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource KickerStyle}" Text="CLÍNICA CAPILAR" />
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Seguimiento del día" />
                <TextBlock Style="{StaticResource SubtitleStyle}" Text="{Binding SubtituloPanel}" />
            </StackPanel>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button
                    AutomationProperties.Name="Adherencia. Abre los cuidados abiertos."
                    Click="AbrirSeccion_Click"
                    Tag="cuidados"
                    Style="{StaticResource TarjetaBoton}"
                    Margin="0"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource KickerStyle}" Text="ADHERENCIA" />
                        <TextBlock Style="{StaticResource CifraStyle}" Text="{Binding AdherenciaMediaTexto}" />
                        <TextBlock Style="{StaticResource SubtitleStyle}" Text="Media de las pautas todavía abiertas" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    AutomationProperties.Name="En riesgo. Abre las pautas con más de tres días de retraso."
                    Click="AbrirSeccion_Click"
                    Tag="cuidados-riesgo"
                    Style="{StaticResource TarjetaBoton}"
                    Margin="0"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource KickerStyle}" Text="EN RIESGO" />
                        <TextBlock Foreground="{StaticResource EstadoRiesgoBrush}" Style="{StaticResource CifraStyle}" Text="{Binding RiesgoNumero}" />
                        <TextBlock Style="{StaticResource SubtitleStyle}" Text="{Binding RiesgoDetalle}" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    AutomationProperties.Name="Intervenciones. Abre las operaciones."
                    Click="AbrirSeccion_Click"
                    Tag="operaciones"
                    Style="{StaticResource TarjetaBoton}"
                    Margin="0"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource KickerStyle}" Text="INTERVENCIONES" />
                        <TextBlock Style="{StaticResource CifraStyle}" Text="{Binding ImporteMesTexto}" />
                        <TextBlock Style="{StaticResource SubtitleStyle}" Text="Importe de las operaciones de este mes" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="3"
                    AutomationProperties.Name="Por cobrar. Abre los productos pendientes de cobro."
                    Click="AbrirSeccion_Click"
                    Tag="ventas-pendientes"
                    Style="{StaticResource TarjetaBoton}"
                    Margin="0"
                    VerticalAlignment="Stretch"
                    VerticalContentAlignment="Top">
                    <StackPanel Spacing="4">
                        <TextBlock Style="{StaticResource KickerStyle}" Text="POR COBRAR" />
                        <TextBlock Foreground="{StaticResource EstadoRiesgoBrush}" Style="{StaticResource CifraStyle}" Text="{Binding PendienteTexto}" />
                        <TextBlock Style="{StaticResource SubtitleStyle}" Text="{Binding PendienteDetalle}" />
                    </StackPanel>
                </Button>
            </Grid>

            <TextBlock Style="{StaticResource SubtitleStyle}" Text="Una operación no se cierra en el quirófano: cada una exige cumplir la medicación o la crema pautada. El día de hoy todavía cuenta como abierto." />

            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Pautas en riesgo" />
                    <TextBlock
                        Style="{StaticResource SubtitleStyle}"
                        Text="Ninguna pauta va con más de tres días de retraso."
                        Visibility="{Binding NoHayRiesgo, Converter={StaticResource BoolAVisibilidad}}" />
                    <ItemsControl ItemsSource="{Binding CuidadosEnRiesgo}" Visibility="{Binding HayRiesgo, Converter={StaticResource BoolAVisibilidad}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="14,12"
                                    Style="{StaticResource CardStyle}">
                                    <controls:CuidadoFila Cuidado="{Binding}" MostrarAccion="True" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="10">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Operaciones recientes" />
                    <ItemsControl ItemsSource="{Binding OperacionesRecientes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="AbrirOperacion_Click" Style="{StaticResource TarjetaBoton}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="3">
                                            <TextBlock FontSize="12" Foreground="{StaticResource GoldBrush}" Text="{Binding FechaTexto}" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Tipo}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding ClienteNombre}" />
                                            <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" Text="{Binding MedicoZona}" TextWrapping="Wrap" />
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Foreground="{Binding EstadoPauta, Converter={StaticResource EstadoAColor}}"
                                                Text="{Binding EstadoPauta}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding ImporteTexto}" />
                                            <TextBlock
                                                FontSize="12"
                                                Foreground="{Binding EstadoOperacion, Converter={StaticResource EstadoAColor}}"
                                                Text="{Binding EstadoOperacion}" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
