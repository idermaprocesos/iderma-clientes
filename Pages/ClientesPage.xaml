<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="IdermaClinica.Pages.ClientesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IdermaClinica.Controls">
    <Grid Padding="28,20,28,24" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource KickerStyle}" Text="FICHAS" />
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Clientes" />
            <TextBlock Style="{StaticResource SubtitleStyle}" Text="Cada ficha reúne las operaciones hechas y la medicación o crema que todavía hay que cumplir." />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="Buscador"
                PlaceholderText="Buscar por nombre, teléfono o motivo"
                TextChanged="Buscador_TextChanged" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Foreground="{StaticResource MutedBrush}"
                Text="{Binding Conteo}" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="Lista"
                ItemsSource="{Binding Visibles}"
                SelectionChanged="Lista_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8" />
                        <Setter Property="Margin" Value="0,0,0,4" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnSpacing="12" Padding="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Background="{Binding ColorIndice, Converter={StaticResource IndiceAColor}}"
                                CornerRadius="20">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{Binding Iniciales}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Nombre}" TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{StaticResource MutedBrush}"
                                    Text="{Binding Motivo}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontWeight="SemiBold"
                                    Foreground="{Binding Situacion, Converter={StaticResource EstadoAColor}}"
                                    Text="{Binding AdherenciaTexto}" />
                                <Border
                                    Padding="8,2"
                                    HorizontalAlignment="Right"
                                    Background="{Binding Situacion, Converter={StaticResource EstadoAFondo}}"
                                    CornerRadius="8">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{Binding Situacion, Converter={StaticResource EstadoAColor}}"
                                        Text="{Binding Situacion}" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <ScrollViewer Grid.Column="1">
                <StackPanel Spacing="14">
                    <Border
                        Style="{StaticResource CardStyle}"
                        Visibility="{Binding NoTieneSeleccion, Converter={StaticResource BoolAVisibilidad}}">
                        <TextBlock Style="{StaticResource SubtitleStyle}" Text="Elige un cliente para ver su ficha, las operaciones y la pauta." />
                    </Border>

                    <StackPanel Spacing="14" Visibility="{Binding TieneSeleccion, Converter={StaticResource BoolAVisibilidad}}">
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="56"
                                        Height="56"
                                        Background="{Binding Seleccionado.ColorIndice, Converter={StaticResource IndiceAColor}}"
                                        CornerRadius="28">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding Seleccionado.Iniciales}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock FontSize="22" FontWeight="SemiBold" Text="{Binding Seleccionado.Nombre}" TextWrapping="Wrap" />
                                        <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding Seleccionado.Motivo}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="2"
                                        Padding="10,6"
                                        VerticalAlignment="Center"
                                        Background="{Binding Seleccionado.Situacion, Converter={StaticResource EstadoAFondo}}"
                                        CornerRadius="8">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Seleccionado.Situacion, Converter={StaticResource EstadoAColor}}"
                                            Text="{Binding Seleccionado.Situacion}" />
                                    </Border>
                                </Grid>

                                <Grid ColumnSpacing="12" RowSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Style="{StaticResource KickerStyle}" Text="TELÉFONO" />
                                        <TextBlock IsTextSelectionEnabled="True" Text="{Binding Seleccionado.Telefono}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource KickerStyle}" Text="CORREO" />
                                        <TextBlock IsTextSelectionEnabled="True" Text="{Binding Seleccionado.Correo}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Spacing="2">
                                        <TextBlock Style="{StaticResource KickerStyle}" Text="ALTA" />
                                        <TextBlock Text="{Binding Seleccionado.AltaTexto}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                        <TextBlock Style="{StaticResource KickerStyle}" Text="ZONA" />
                                        <TextBlock Text="{Binding Seleccionado.Zona}" />
                                    </StackPanel>
                                </Grid>

                                <Border Padding="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <TextBlock Text="{Binding Seleccionado.Notas}" TextWrapping="Wrap" />
                                </Border>

                                <StackPanel Spacing="2">
                                    <TextBlock Style="{StaticResource KickerStyle}" Text="ADHERENCIA DE LA PAUTA ABIERTA" />
                                    <TextBlock Style="{StaticResource CifraStyle}" Text="{Binding Seleccionado.AdherenciaTexto}" />
                                    <TextBlock Style="{StaticResource SubtitleStyle}" Text="{Binding Seleccionado.OperacionesTexto}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Operaciones" />
                        <ItemsControl ItemsSource="{Binding OperacionesCliente}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Click="AbrirOperacion_Click" Style="{StaticResource TarjetaBoton}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="2">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Tipo}" TextWrapping="Wrap" />
                                                <TextBlock Foreground="{StaticResource MutedBrush}" Text="{Binding FechaTexto}" />
                                                <TextBlock Text="{Binding Detalle}" TextWrapping="Wrap" />
                                                <TextBlock
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding EstadoPauta, Converter={StaticResource EstadoAColor}}"
                                                    Text="{Binding EstadoPauta}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding ImporteTexto}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Pauta que debe cumplir" />
                        <ItemsControl ItemsSource="{Binding CuidadosCliente}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="12,10" Style="{StaticResource CardStyle}">
                                        <controls:CuidadoFila Cuidado="{Binding}" MostrarAccion="True" MostrarCliente="False" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
